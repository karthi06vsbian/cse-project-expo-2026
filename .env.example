# ------------------------------------------------------------------------------
# 1. GOOGLE FIREBASE WEB CLIENT (Safe for browser)
# Obtain from: Firebase Console -> Project Settings -> General -> Your Apps -> </>
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cse-project-expo-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cse-project-expo-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cse-project-expo-2026.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (Server-side only — NEVER expose to browser)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Key
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=cse-project-expo-2026
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@cse-project-expo-2026.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. META WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
META_WHATSAPP_ACCESS_TOKEN=EAAG...
META_WHATSAPP_PHONE_NUMBER_ID=109283746592837
META_WHATSAPP_BUSINESS_ACCOUNT_ID=982736451928374
META_WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 4. APPLICATION & DOMAIN URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. DEPARTMENT FACULTY ADMIN AUTHENTICATION
# Access directly via: /admin or /admin/login
