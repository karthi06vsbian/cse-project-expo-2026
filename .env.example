# ==============================================================================
# CSE PROJECT EXPO 2026 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Project URL from Supabase Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key from Supabase Settings -> API (Safe for client browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (NEVER expose to browser — server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. META WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
# System User or Permanent Access Token from Meta Business Manager
META_WHATSAPP_ACCESS_TOKEN=EAAG...

# Phone Number ID from Meta App Dashboard -> WhatsApp -> API Setup
META_WHATSAPP_PHONE_NUMBER_ID=109283746592837

# WhatsApp Business Account ID (WABA ID)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=982736451928374

# Graph API Version
META_WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 3. APPLICATION & DOMAIN URLS
# ------------------------------------------------------------------------------
# Base URL of application (Used for OAuth redirects and WhatsApp webhooks)
# Local: http://localhost:3000 | Production: https://cse-expo-2026.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. DEPARTMENT FACULTY ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=expo2026admin
